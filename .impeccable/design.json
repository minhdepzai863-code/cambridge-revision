  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main action, such as logging a paper.",
      "html": "<button class=\"ds-primary\" type=\"button\">Log paper</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:9px 14px;border:1px solid transparent;border-radius:7px;font:500 14px var(--font-ui,\"Open Sans\",Arial,sans-serif);cursor:pointer;transition:background-color .16s ease,color .16s ease,border-color .16s ease,box-shadow .16s ease;background:var(--action,#303632);color:var(--on-action,#fffefa);font-weight:600}.ds-primary:hover{opacity:.9}.ds-primary:focus-visible{outline:2px solid var(--focus,#526b60);outline-offset:3px}.ds-primary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Quiet action",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "A lower-emphasis action with a hover surface.",
      "html": "<button class=\"ds-quiet\" type=\"button\">View details</button>",
      "css": ".ds-quiet{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:9px 14px;border:1px solid transparent;border-radius:7px;font:500 14px var(--font-ui,\"Open Sans\",Arial,sans-serif);cursor:pointer;transition:background-color .16s ease,color .16s ease,border-color .16s ease,box-shadow .16s ease;background:transparent;color:var(--text,#3d403d)}.ds-quiet:hover{background:var(--hover,#eaece5)}.ds-quiet:focus-visible{outline:2px solid var(--focus,#526b60);outline-offset:3px}"
    },
    {
      "name": "Paper search field",
      "kind": "input",
      "refersTo": "input",
      "description": "A persistent label and a clear input boundary.",
      "html": "<label class=\"ds-field\"><span>Search papers and files</span><input type=\"search\" placeholder=\"Paper code, syllabus or attachment\"></label>",
      "css": ".ds-field{display:grid;gap:7px;font:500 14px var(--font-ui,\"Open Sans\",Arial,sans-serif);color:var(--text,#3d403d)}.ds-field input{min-height:42px;min-width:0;padding:10px 12px;background:var(--surface,#fdfcf9);color:var(--ink,#242625);border:1px solid var(--input-line,#878d84);border-radius:7px;font:400 14px var(--font-ui,\"Open Sans\",Arial,sans-serif)}.ds-field input::placeholder{color:var(--muted,#5f645f);opacity:1}.ds-field input:hover{border-color:var(--input-hover,#626b61)}.ds-field input:focus-visible{outline:2px solid var(--focus,#526b60);outline-offset:3px}@media(max-width:760px){.ds-field input{font-size:16px}}"
    },
    {
      "name": "Navigation disclosure",
      "kind": "nav",
      "refersTo": "nav-selected",
      "description": "A labelled group with the current destination marked.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example workspace navigation\"><details open><summary>Workspace <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M5 12h14m-5-5 5 5-5 5\"/></svg></summary><button type=\"button\" aria-current=\"page\">Dashboard</button><button type=\"button\">Study plan</button><button type=\"button\">Analytics</button></details><details><summary>Practice <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M5 12h14m-5-5 5 5-5 5\"/></svg></summary><button type=\"button\">Past papers</button></details></nav>",
      "css": ".ds-nav{max-width:240px;background:var(--sidebar,#eeede8);padding:12px}.ds-nav details{margin:8px 0 13px}.ds-nav summary{display:flex;align-items:center;justify-content:space-between;min-height:36px;padding:3px 10px;cursor:pointer;list-style:none;color:var(--muted,#5f645f);font:650 12px var(--font-ui,\"Open Sans\",Arial,sans-serif)}.ds-nav summary::-webkit-details-marker{display:none}.ds-nav details[open] summary svg{transform:rotate(90deg)}.ds-nav button{display:block;width:100%;min-height:40px;margin:1px 0;padding:7px 9px;text-align:left;border:0;border-radius:7px;cursor:pointer;background:transparent;color:var(--text,#3d403d);font:500 13px/1.5 var(--font-ui,\"Open Sans\",Arial,sans-serif)}.ds-nav button:hover{background:var(--hover,#eaece5)}.ds-nav button[aria-current]{background:var(--nav-active,#dfe7df);color:var(--nav-on-active,#23352d);font-weight:600}.ds-nav :is(button,summary):focus-visible{outline:2px solid var(--focus,#526b60);outline-offset:3px}@media(max-width:760px){.ds-nav :is(button,summary){min-height:44px}}"
    },
    {
      "name": "Document role chip",
      "kind": "chip",
      "refersTo": "attachment-chip",
      "description": "A quiet file action that names the attachment role.",
      "html": "<button type=\"button\" class=\"ds-chip\" aria-label=\"Open question paper 9709_s24_qp_12.pdf\">Question paper</button>",
      "css": ".ds-chip{min-height:30px;padding:5px 8px;border:1px solid transparent;border-radius:5px;background:var(--soft,#eeefe9);color:var(--text,#3d403d);font:400 12px/1.5 var(--font-ui,\"Open Sans\",Arial,sans-serif);cursor:pointer}.ds-chip:hover{background:var(--hover,#eaece5)}.ds-chip:focus-visible{outline:2px solid var(--focus,#526b60);outline-offset:3px}"
    },
    {
      "name": "Next study task",
      "kind": "card",
      "refersTo": "next-task",
      "description": "A task paired with the examination note in a quieter plane.",
      "html": "<section class=\"ds-task\" aria-label=\"Example next study task\"><div><h2>Revisit a saved question</h2><p>A bookmark is ready for review.</p><button type=\"button\">Open review queue</button></div><div><span>Next examination</span><p>Add a date confirmed by your centre.</p></div></section>",
      "css": ".ds-task{display:grid;grid-template-columns:minmax(0,1fr) minmax(180px,.42fr);background:var(--surface,#fdfcf9);color:var(--ink,#242625);border-radius:11px;font:400 14px/1.65 var(--font-ui,\"Open Sans\",Arial,sans-serif)}.ds-task>div{padding:20px 24px}.ds-task>div+div{background:var(--soft,#eeefe9);border-radius:0 11px 11px 0}.ds-task h2{font:450 29px/1.15 var(--font-editorial,Newsreader,Georgia,serif);margin:4px 0 7px}.ds-task p{margin:0 0 10px;color:var(--muted,#5f645f)}.ds-task span{font-weight:600;color:var(--accent,#526b60)}.ds-task button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:9px 14px;border:1px solid transparent;border-radius:7px;font:500 14px var(--font-ui,\"Open Sans\",Arial,sans-serif);cursor:pointer;transition:background-color .16s ease,color .16s ease,border-color .16s ease,box-shadow .16s ease;background:var(--action,#303632);color:var(--on-action,#fffefa);font-weight:600}.ds-task button:hover{opacity:.9}.ds-task button:focus-visible{outline:2px solid var(--focus,#526b60);outline-offset:3px}@media(max-width:760px){.ds-task{grid-template-columns:1fr}.ds-task>div{padding:16px}.ds-task>div+div{border-radius:0 0 11px 11px}}"
    },
    {
      "name": "Sample paper ledger",
      "kind": "custom",
      "refersTo": "sample-ledger",
      "description": "The public folio demonstrates repeat attempts with labelled example data.",
      "html": "<figure class=\"ds-ledger\"><figcaption><span><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M12 6c-3-3-7-3-10-2v15c4-1 7 0 10 2 3-2 6-3 10-2V4c-3-1-7-1-10 2zm0 0v15\"/></svg> Revision workspace</span><span>Example data</span></figcaption><div class=\"ds-ledger-body\"><small>Mathematics / 9709</small><h2>Paper record</h2><div class=\"ds-ledger-scores\"><div><strong>84%</strong><small>Latest attempt</small></div><div><strong>+12</strong><small>Percentage points</small></div></div><svg viewBox=\"0 0 420 95\" role=\"img\" aria-label=\"Example scores of 72, 77 and 84 percent\"><path d=\"M10 23H410M10 52H410M10 81H410\" stroke=\"var(--line,#d9dbd4)\"/><path d=\"M22 70L210 51 398 25\" stroke=\"var(--chart-high,#526b60)\" stroke-width=\"2.5\" fill=\"none\"/><g fill=\"var(--chart-high,#526b60)\"><circle cx=\"22\" cy=\"70\" r=\"4\"/><circle cx=\"210\" cy=\"51\" r=\"4\"/><circle cx=\"398\" cy=\"25\" r=\"4\"/></g></svg><div class=\"ds-ledger-row\"><span>9709/12/M/J/24</span><strong>63 / 75</strong><small>Latest</small></div><div class=\"ds-ledger-row\"><span>9709/12/M/J/24</span><strong>54 / 75</strong><small>First attempt</small></div><div class=\"ds-ledger-note\"><span>Next review</span><strong>Q6 · Differentiation</strong></div></div></figure>",
      "css": ".ds-ledger{margin:0;overflow:hidden;border:1px solid var(--line,#d9dbd4);border-radius:13px;background:var(--surface,#fdfcf9);color:var(--ink,#242625);box-shadow:0 14px 40px rgb(24 27 24 / .07);font:400 13px/1.65 var(--font-ui,\"Open Sans\",Arial,sans-serif)}.ds-ledger figcaption{display:flex;justify-content:space-between;gap:12px;padding:13px 22px;background:var(--sidebar,#eeede8);color:var(--muted,#5f645f)}.ds-ledger figcaption span:first-child{display:flex;align-items:center;gap:8px;color:var(--ink,#242625)}.ds-ledger-body{padding:22px 25px}.ds-ledger h2{font:450 32px/1.2 var(--font-editorial,Newsreader,Georgia,serif);margin:0}.ds-ledger small{font-size:13px;color:var(--muted,#5f645f)}.ds-ledger-scores{display:grid;grid-template-columns:1fr 1fr;margin:18px 0 10px}.ds-ledger-scores>div+div{border-left:1px solid var(--line,#d9dbd4);padding-left:20px}.ds-ledger-scores strong{display:block;font-size:33px;line-height:1.2;font-variant-numeric:tabular-nums}.ds-ledger-body>svg{display:block;width:100%;margin:10px 0}.ds-ledger-row{display:grid;grid-template-columns:1.4fr .7fr 1fr;gap:10px;padding:10px 0;border-top:1px solid var(--line,#d9dbd4)}.ds-ledger-row small{text-align:right}.ds-ledger-note{display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px 12px;margin-top:9px;padding:9px 12px;background:var(--green,#e5ebe5);border-radius:6px}@media(max-width:380px){.ds-ledger-body{padding-inline:13px}}"
    },
    {
      "name": "Subject collection",
      "kind": "custom",
      "refersTo": "collection-tab",
      "description": "A subject tab joins the paper library surface below it.",
      "html": "<section class=\"ds-collection\"><header><div><h2><svg width=\"44\" height=\"35\" viewBox=\"0 0 56 44\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 10V7a3 3 0 0 1 3-3h14l6 6h24a3 3 0 0 1 3 3v24a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V10z\" fill=\"var(--folder-back,#babfb8)\" stroke=\"var(--folder-edge,#818980)\"/><path d=\"M9 14h38v12H9z\" fill=\"var(--folder-page,#f7f7f8)\"/><path d=\"M3 18h50l-2 20a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3L3 18z\" fill=\"var(--folder-front,#d5d8d0)\" stroke=\"var(--folder-edge,#818980)\"/></svg> Mathematics</h2><p>Cambridge 9709</p></div><span>1 paper / 2 attempts</span></header><div class=\"ds-collection-columns\"><span>Paper &amp; documents</span><span>Latest attempt</span><span>Best full paper</span></div></section>",
      "css": ".ds-collection{font:400 12px/1.65 var(--font-ui,\"Open Sans\",Arial,sans-serif);color:var(--muted,#5f645f)}.ds-collection header{display:flex;align-items:flex-end;justify-content:space-between;gap:18px}.ds-collection header>div{background:var(--surface,#fdfcf9);border-radius:12px 12px 0 0;padding:15px 24px 13px}.ds-collection header>span{padding:0 3px 12px;text-align:right}.ds-collection h2{display:flex;align-items:center;gap:11px;color:var(--ink,#242625);font:450 22px/1.3 var(--font-editorial,Newsreader,Georgia,serif);margin:0}.ds-collection h2 svg{flex:none}.ds-collection p{margin:5px 0 0 55px}.ds-collection-columns{display:flex;justify-content:space-between;gap:22px;background:var(--surface,#fdfcf9);padding:12px 24px;border-radius:0 12px 12px 12px}@media(max-width:760px){.ds-collection h2{font-size:21px}.ds-collection h2 svg{width:36px;height:29px}.ds-collection p{margin-left:45px}}"
    }
  ],
  "narrative": {
    "northStar": "A student's working folio",
    "overview": "Cambridge Revision brings paper records, marks and corrections into one study sequence. Ivory, stone and warm-white surfaces frame the work in light mode. Neutral charcoal carries the same hierarchy in dark mode. Newsreader gives the page an editorial voice, and Open Sans keeps controls and results easy to scan.\n\nThe public folio introduces the method with a credited archival photograph and an explicitly labelled sample record. The workspace carries that visual language into private or device-local study, where the next action, exam preparation and actual saved evidence lead the page. The open-book symbol and name identify an independent tool.",
    "keyCharacteristics": [
      "Shared ivory and charcoal themes across public, account and workspace pages.",
      "Editorial headings with functional labels, codes and tabular numerical evidence.",
      "Credited archival imagery on the public folio and quiet, data-led workspace surfaces.",
      "Navigation grouped around planning, practice, review and reference.",
      "Aligned records and restrained color for selection, progress and feedback."
    ],
    "rules": [
      {
        "name": "The Role Consistency Rule",
        "body": "Reuse shared surface, action, focus and analytical roles across pages and themes.",
        "section": "colors"
      },
      {
        "name": "The Editorial and Evidence Rule",
        "body": "Use Newsreader for editorial headings and Open Sans for functional information. Marks, time and counts use tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Open Record Rule",
        "body": "Use alignment and quiet rules to organize repeated records.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do give the next useful task and saved evidence a clear reading order.",
      "Do pair editorial headings with functional labels, codes and tabular results.",
      "Do keep route, focus and progress states legible in both themes.",
      "Do keep archival source credits visible and label illustrative scores as example data.",
      "Do keep file roles, attempt scope and score labels visible at narrow widths."
    ],
    "donts": [
      "Don't invent scores, grades, exam dates or provenance for workspace records.",
      "Don't use institutional logos, arms or wordmarks for the independent project."
    ]
  }
}
